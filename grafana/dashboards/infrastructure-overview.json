{
    "uid":  "infra-overview",
    "title":  "Infrastructure Overview",
    "tags":  [
                 "infrastructure",
                 "observability",
                 "docker"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "15s",
    "time":  {
